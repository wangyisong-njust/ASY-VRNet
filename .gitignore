# ---- Python / IDE / env ----
__pycache__/
*.py[cod]
*$py.class
.idea/
.vscode/
venv/
.venv/
env/

# ---- runtime scratch ----
.temp_map_out/
.temp_miou_out/
paper_metrics_out/
img_crop/
img_out/
*.log
logs/*.pid
logs/*.out
logs/*.lock
logs/*.latest

# ---- datasets & downloads (publicly available, fetch separately) ----
dataset/
downloads/

# ---- pretrained backbone (publicly downloadable, see docs/reproduction.md) ----
model_data/**/*.pth.tar

# ---- model weights (not shipped; regenerate via scripts/greedy_soup.py) ----
*.pth

# ---- intermediate training / evaluation outputs (not shipped) ----
logs/
logs_seg/
logs_*/
logs_seg_*/
reproduction_reports/
results_archives/
predict_output/
predict_output_seg/

# ---- keep only the compact final metric summaries under paper_metrics_*/ ----
paper_metrics_*/*
!paper_metrics_*/paper_metrics.json
!paper_metrics_*/paper_metrics.csv
