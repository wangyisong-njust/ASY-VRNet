# ---- Python / IDE / env ----
__pycache__/
*.py[cod]
*$py.class
.idea/
.vscode/
venv/
.venv/
env/

# ---- runtime scratch ----
.temp_map_out/
.temp_miou_out/
paper_metrics_out/
img_crop/
img_out/
outputs/
*.log
logs/*.pid
logs/*.out
logs/*.lock
logs/*.latest

# ---- datasets & downloads (publicly available, fetch separately) ----
dataset/
downloads/

# ---- pretrained backbone (publicly downloadable, see docs/reproduction.md) ----
model_data/**/*.pth.tar

# ---- model weights ----
# Final delivery checkpoints are tracked with Git LFS.
!weights/
!weights/*.pth

# ---- intermediate training / evaluation outputs (not shipped) ----
logs/
logs_*/
logs_seg_*/
reproduction_reports/
results_archives/
predict_output/
predict_output_seg/

# ---- results/: keep only the compact final metric summaries ----
results/**/*
!results/
!results/**/
!results/**/paper_metrics.json
!results/**/paper_metrics.csv
